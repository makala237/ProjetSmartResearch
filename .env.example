# --- Google Gemini API ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- Model Routing (primary -> fallbacks, comma-separated) ---
GEMINI_PRIMARY_REASONING_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_REASONING_MODEL=gemini-3.1-flash-lite
AI_USER_MAX_TOKENS_PER_DAY=100000
GEMINI_MODELS_RESEARCH=gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-3.5-flash
GEMINI_MODELS_SEGMENTATION=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.5-flash
GEMINI_MODELS_DRAFTING=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.5-flash
GEMINI_MODELS_AUDIT=gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-3.5-flash
GEMINI_MODELS_LIVE_TRANSLATE=gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-3.5-flash
GEMINI_MODELS_LAYOUT_DECISION=gemini-decision-1,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.5-flash

# --- Academic APIs (optional free keys for higher quotas) ---
NCBI_API_KEY=
OPENALEX_API_KEY=
OPENALEX_EMAIL=

# --- SaaS Database Backend (sql = SQLite/PostgreSQL | firestore = Cloud Firestore Enterprise + BlobStorage) ---
DB_BACKEND=sql
FIRESTORE_PROJECT_ID=smart-research-fmsb
FIRESTORE_DATABASE=smartresearch-prod
DATABASE_URL=
RUN_MIGRATIONS_ON_START=true

# --- Authentication & Bootstrap Admin ---
JWT_SECRET_KEY=replace-with-at-least-64-random-hex-characters
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14
BOOTSTRAP_ADMIN_EMAIL=admin@smartresearch.cm
BOOTSTRAP_ADMIN_PASSWORD=ChangeMeAdmin2026!
BOOTSTRAP_ADMIN_NAME=Administrateur Principal
CORS_ORIGINS=http://localhost:8001,http://localhost:5173

# --- Phase 5: Document Render Engine (auto | com | libreoffice | cloud_api) ---
RENDER_ENGINE=auto
CLOUD_RENDER_API_URL=
CLOUD_RENDER_API_KEY=

# --- Phase 5: Binary Object Storage (local | gcs | s3) ---
STORAGE_BACKEND=local
CLOUD_STORAGE_BUCKET=
CLOUD_STORAGE_PREFIX=smartresearch
CLOUD_STORAGE_ENDPOINT_URL=
CLOUD_STORAGE_ACCESS_KEY=
CLOUD_STORAGE_SECRET_KEY=
CLOUD_STORAGE_REGION=auto
